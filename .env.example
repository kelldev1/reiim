# Copy to `.env` and fill in (Supabase dashboard → Project Settings → API).
# These are PUBLIC values (safe in the browser bundle).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# The model key is NEVER here — it goes in Supabase as a function secret:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
