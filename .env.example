# Copier vers `.env` et remplir (Supabase → Project Settings → API).
# Ces deux valeurs sont PUBLIQUES (elles vivent dans le bundle navigateur ;
# c'est la RLS qui protège les données, pas le secret de la clé anon).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Les clés serveur ne sont JAMAIS ici — ce sont des secrets de fonction Supabase :
#   supabase secrets set LLM_API_KEY=sk-ant-...          (API Anthropic)
#   supabase secrets set YT_API_KEY=AIza...              (YouTube Data API v3)
#   supabase secrets set ALLOWED_ORIGINS=https://app.exemple.fr   (CORS, optionnel)
